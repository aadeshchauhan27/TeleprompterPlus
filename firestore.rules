rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && request.auth.token.email.lower() == userId.lower())
      );
    }

    // App-isolated Teleprompter Plus root collection
    match /teleprompter_users/{userId} {
      allow read, write: if isOwner(userId);

      match /scripts/{scriptId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /settings/{docId} {
        allow read, write, delete: if isOwner(userId);
      }

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // App-isolated Phone Doctor root collection
    match /phonedoctor_users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // App-isolated WakeUp root collection
    match /wakeup_users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Legacy fallback for backward-compatible migration
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Default deny for unauthenticated or other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
